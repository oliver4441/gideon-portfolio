    <div class="schedule-overlay" id="scheduleOverlay">
      <div class="schedule-modal" role="dialog" aria-modal="true" aria-labelledby="scheduleTitle">
        <button class="schedule-close" type="button" data-schedule-close aria-label="Close scheduling">×</button>
        <div class="schedule-progress"><i id="scheduleBar"></i></div>
        <p class="schedule-step" id="scheduleStepLabel">Step 1 of 3</p>
        <h3 id="scheduleTitle">What would you like to talk about?</h3>
        <div class="schedule-pane is-active" data-pane="1">
          <div class="schedule-options" role="radiogroup" aria-label="Meeting topic">
            <button type="button" class="schedule-option" data-topic="A new product idea"><span class="dot" aria-hidden="true"></span><span><strong>A product idea</strong><span>You have something you want to build.</span></span></button>
            <button type="button" class="schedule-option" data-topic="A project with OMIX"><span class="dot" aria-hidden="true"></span><span><strong>A project with OMIX</strong><span>Scope, quote or ongoing work.</span></span></button>
            <button type="button" class="schedule-option" data-topic="Partnership"><span class="dot" aria-hidden="true"></span><span><strong>Partnership</strong><span>Collaborations and business.</span></span></button>
            <button type="button" class="schedule-option" data-topic="Just a conversation"><span class="dot" aria-hidden="true"></span><span><strong>Just a conversation</strong><span>Advice, questions, or saying hi.</span></span></button>
          </div>
          <p class="schedule-error" hidden>Please pick a topic to continue.</p>
          <div class="schedule-nav"><span></span><button class="button dark" type="button" data-next>Continue →</button></div>
        </div>
        <div class="schedule-pane" data-pane="2">
          <label class="schedule-field">Your name<input id="scheduleName" type="text" name="name" placeholder="Jane Doe" autocomplete="name"/></label>
          <label class="schedule-field">Email address<input id="scheduleEmail" type="email" name="email" placeholder="jane@example.com" autocomplete="email"/></label>
          <p class="schedule-error" hidden>Please add your name and a valid email so I can reach you.</p>
          <div class="schedule-nav"><button class="text-link" type="button" data-back>← Back</button><button class="button dark" type="button" data-next>Continue →</button></div>
        </div>
        <div class="schedule-pane" data-pane="3">
          <label class="schedule-field">Anything I should know first? <span style="text-transform:none;letter-spacing:0">(optional)</span><textarea id="scheduleNotes" placeholder="A sentence or two about what you want to discuss…"></textarea></label>
          <div class="schedule-summary" id="scheduleSummary"></div>
          <div class="schedule-nav"><button class="text-link" type="button" data-back>← Back</button><a class="button gold" id="scheduleGo" href="https://calendly.com/twistedoliver211fs/discussion" target="_blank" rel="noopener">Pick a time →</a></div>
          <p class="schedule-note">You will choose a day and time on the next screen — your details carry over automatically.</p>
        </div>
        <div class="schedule-pane" data-pane="4">
          <p class="schedule-done-text">My calendar should now be open in a new tab with your details already filled in. Pick a time that suits you — I look forward to talking.</p>
          <div class="schedule-nav"><a class="text-link" id="scheduleReopen" href="https://calendly.com/twistedoliver211fs/discussion" target="_blank" rel="noopener">Reopen calendar</a><button class="button outline" type="button" data-schedule-close>Done</button></div>
        </div>
      </div>
    </div>

    <script is:inline>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mobile = matchMedia('(max-width: 1080px)');

      /* Reveal-on-scroll */
      const reveal = new IntersectionObserver(e => e.forEach(x => { if (x.isIntersecting) x.target.classList.add('is-visible') }), { threshold: mobile.matches ? .08 : .14, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('[data-reveal]').forEach(e => reveal.observe(e));

      /* Scroll-spy — side nav + mobile menu */
      const sections = [...document.querySelectorAll('[data-section-target]')];
      const navLinks = [...document.querySelectorAll('[data-section]')];
      const setActive = id => navLinks.forEach(a => a.classList.toggle('is-active', a.dataset.section === id));
      const sectionObserver = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) setActive(entry.target.dataset.sectionTarget) }), { rootMargin: '-38% 0px -52% 0px', threshold: 0 });
      sections.forEach(s => sectionObserver.observe(s));

      /* Mobile menu */
      document.querySelectorAll('.mobile-menu a, .side-links a').forEach(a => a.addEventListener('click', () => {
        document.body.classList.remove('index-open');
        document.querySelector('.menu-btn')?.setAttribute('aria-expanded', 'false');
      }));
      const toggle = document.querySelector('.menu-btn');
      toggle?.addEventListener('click', () => {
        const open = !document.body.classList.contains('index-open');
        document.body.classList.toggle('index-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
      addEventListener('keydown', e => { if (e.key === 'Escape') { document.body.classList.remove('index-open'); toggle?.setAttribute('aria-expanded', 'false'); } });

      /* Parallax + scroll progress */
      const p = [...document.querySelectorAll('[data-parallax]')];
      let ticking = false;
      const update = () => {
        document.documentElement.style.setProperty('--scroll-y', `${scrollY}px`);
        if (reduce || mobile.matches) { ticking = false; return; }
        const vh = innerHeight;
        p.forEach(el => {
          const r = el.getBoundingClientRect(), v = Number(el.dataset.parallax || 0), o = ((r.top + r.height / 2 - vh / 2) / vh) * -70 * v;
          el.style.setProperty('--parallax-y', `${o}px`);
        });
        ticking = false;
      };
      addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
      addEventListener('resize', update, { passive: true });
      update();

      /* Magnetic buttons */
      document.querySelectorAll('.magnetic').forEach(el => {
        el.addEventListener('pointermove', e => {
          if (reduce || mobile.matches) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${(e.clientX - r.left - r.width / 2) * .12}px`);
          el.style.setProperty('--my', `${(e.clientY - r.top - r.height / 2) * .12}px`);
        });
        el.addEventListener('pointerleave', () => { el.style.setProperty('--mx', '0px'); el.style.setProperty('--my', '0px'); });
      });

      /* Scheduling modal */
      ;(() => {
        const CAL = 'https://calendly.com/twistedoliver211fs/discussion';
        const overlay = document.getElementById('scheduleOverlay');
        if (!overlay) return;
        const title = document.getElementById('scheduleTitle'), stepLabel = document.getElementById('scheduleStepLabel'), bar = document.getElementById('scheduleBar');
        const panes = [...overlay.querySelectorAll('.schedule-pane')];
        const state = { topic: '', name: '', email: '', notes: '' };
        let step = 1;
        const titles = { 1: 'What would you like to talk about?', 2: 'How do I reach you?', 3: 'Anything I should know first?', 4: 'One last step — pick a time.' };
        const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        function renderSummary() {
          const rows = [['Topic', state.topic], ['Name', state.name], ['Email', state.email]];
          if (state.notes) rows.push(['Notes', state.notes.length > 90 ? state.notes.slice(0, 90) + '…' : state.notes]);
          document.getElementById('scheduleSummary').innerHTML = rows.map(([k, v]) => '<div><span>' + k + '</span><strong>' + esc(v) + '</strong></div>').join('');
          const a1 = (state.topic + (state.notes ? ' — ' + state.notes : '')).slice(0, 500);
          const url = CAL + '?name=' + encodeURIComponent(state.name) + '&email=' + encodeURIComponent(state.email) + '&a1=' + encodeURIComponent(a1);
          document.getElementById('scheduleGo').href = url;
          document.getElementById('scheduleReopen').href = url;
        }
        function show(n) {
          step = n;
          panes.forEach(p => p.classList.toggle('is-active', +p.dataset.pane === n));
          title.textContent = titles[n];
          stepLabel.textContent = n < 4 ? ('Step ' + n + ' of 3') : 'Almost done';
          bar.style.width = (n >= 4 ? 100 : n * 33.34) + '%';
          panes[n - 1].querySelectorAll('.schedule-error').forEach(e => e.hidden = true);
          if (n === 3) renderSummary();
          const f = panes[n - 1].querySelector('input,.schedule-option');
          if (f && n < 3) f.focus({ preventScroll: true });
        }
        function openM() { overlay.classList.add('is-open'); document.body.style.overflow = 'hidden'; show(1); }
        function closeM() { overlay.classList.remove('is-open'); document.body.style.overflow = ''; }
        document.querySelectorAll('[data-open-schedule]').forEach(b => b.addEventListener('click', openM));
        overlay.querySelectorAll('[data-schedule-close]').forEach(b => b.addEventListener('click', closeM));
        overlay.addEventListener('click', e => { if (e.target === overlay) closeM(); });
        addEventListener('keydown', e => { if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeM(); });
        overlay.querySelectorAll('.schedule-option').forEach(o => o.addEventListener('click', () => {
          overlay.querySelectorAll('.schedule-option').forEach(x => x.classList.remove('is-selected'));
          o.classList.add('is-selected');
          state.topic = o.dataset.topic;
          o.closest('.schedule-pane').querySelector('.schedule-error').hidden = true;
        }));
        overlay.querySelectorAll('[data-next]').forEach(b => b.addEventListener('click', () => {
          const pane = panes[step - 1], err = pane.querySelector('.schedule-error');
          if (step === 1 && !state.topic) { err.hidden = false; return; }
          if (step === 2) {
            state.name = document.getElementById('scheduleName').value.trim();
            state.email = document.getElementById('scheduleEmail').value.trim();
            if (!state.name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.email)) { err.hidden = false; return; }
          }
          show(step + 1);
        }));
        overlay.querySelectorAll('[data-back]').forEach(b => b.addEventListener('click', () => show(step - 1)));
        document.getElementById('scheduleGo').addEventListener('click', () => {
          state.notes = document.getElementById('scheduleNotes').value.trim();
          renderSummary();
          setTimeout(() => show(4), 400);
        });
      })();
    </script>
  </body>
