const work=[{n:'01',name:'Veyra',type:'Product · Media',title:'A cinematic streaming platform.',body:'A product exploring discovery, presentation and the infrastructure required to turn a media idea into a usable platform.',href:'https://web-jade-one-82.vercel.app/?type=series'},{n:'02',name:'Phikila',type:'Product · Education',title:'School management, treated as a system.',body:'A connected platform for school operations, academic workflows and the information institutions rely on every day.',href:'https://phikila.com/'},{n:'03',name:'OMIX Marketplace',type:'Product · Commerce · OMIX',title:'A local marketplace built for Kericho.',body:'OMIX’s flagship commerce platform, connecting local buyers and sellers with an online marketplace designed around the Kenyan market, including M-Pesa-enabled commerce.',href:'https://market.omixsystems.store/'},{n:'04',name:'OMIX Systems',type:'Company · Software',title:'The company behind the work.',body:'Optimal Modular Integration Experts. A software company built around products, systems and integrations.',href:'https://omixsystems.store/'}];
const capabilities=[['01','Product engineering','From rough idea to working product, with architecture designed to survive beyond an MVP.'],['02','Systems & integrations','APIs, data, authentication, payments and services designed to connect rather than become islands.'],['03','Cloud & infrastructure','Deployment, environments and operational foundations that keep products moving.'],['04','AI & automation','Practical use of models, agents and automation where they create leverage instead of noise.']];
