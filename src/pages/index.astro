('scheduleSummary').innerHTML=rows.map(([k,v])=>'<div><span>'+k+'</span><strong>'+esc(v)+'</strong></div>').join('');const a1=(state.topic+(state.notes?' \u2014 '+state.notes:'')).slice(0,500);const url=CAL+'?name='+encodeURIComponent(state.name)+'&email='+encodeURIComponent(state.email)+'&a1='+encodeURIComponent(a1);document.getElementById('scheduleGo').href=url;document.getElementById('scheduleReopen').href=url;}function show(n){step=n;panes.forEach(p=>p.classList.toggle('is-active',+p.dataset.pane===n));title.textContent=titles[n];stepLabel.textContent=n<4?('Step '+n+' of 3'):'Almost done';bar.style.width=(n>=4?100:n*33.34)+'%';panes[n-1].querySelectorAll('.schedule-error').forEach(e=>e.hidden=true);if(n===3)renderSummary();const f=panes[n-1].querySelector('input,.schedule-option');if(f&&n<3)f.focus({preventScroll:true});}function openM(){overlay.classList.add('is-open');document.body.style.overflow='hidden';show(1);}function closeM(){overlay.classList.remove('is-open');document.body.style.overflow='';}document.querySelectorAll('[data-open-schedule]').forEach(b=>b.addEventListener('click',openM));overlay.querySelectorAll('[data-schedule-close]').forEach(b=>b.addEventListener('click',closeM));overlay.addEventListener('click',e=>{if(e.target===overlay)closeM();});addEventListener('keydown',e=>{if(e.key==='Escape'&&overlay.classList.contains('is-open'))closeM();});overlay.querySelectorAll('.schedule-option').forEach(o=>o.addEventListener('click',()=>{overlay.querySelectorAll('.schedule-option').forEach(x=>x.classList.remove('is-selected'));o.classList.add('is-selected');state.topic=o.dataset.topic;o.closest('.schedule-pane').querySelector('.schedule-error').hidden=true;}));overlay.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',()=>{const pane=panes[step-1],err=pane.querySelector('.schedule-error');if(step===1&&!state.topic){err.hidden=false;return;}if(step===2){state.name=document.getElementById('scheduleName').value.trim();state.email=documen