// Featured products — the live projects this portfolio points at.
const work = [
  {
    n: '01',
    name: 'Veyra',
    type: 'Product · Streaming',
    title: 'A cinematic streaming platform.',
    body: 'A product exploring discovery, presentation and the infrastructure required to turn a media idea into a usable platform — trending titles, ratings and a full catalogue of movies and series.',
    href: 'https://web-jade-one-82.vercel.app/?type=series',
    shot: hosted.veyra,
    mark: 'V',
    tags: ['Streaming', 'TMDB', 'PWA'],
  },
  {
    n: '02',
    name: 'Phikila',
    type: 'Product · Education',
    title: 'School management, treated as a system.',
    body: 'A connected platform for school operations — timetables, students & staff, attendance, academics and reporting — and the information institutions rely on every day.',
    href: 'https://phikila.com/',
    shot: hosted.phikila,
    mark: 'P',
    tags: ['EdTech', 'School operations', 'Platform'],
  },
  {
    n: '03',
    name: 'OMIX Marketplace',
    type: 'Product · Commerce · OMIX',
    title: 'A local marketplace built for Kericho.',
    body: 'OMIX’s flagship commerce platform, connecting local buyers and sellers with an online marketplace designed around the Kenyan market — including M-Pesa-enabled commerce.',
    href: 'https://market.omixsystems.store/',
    shot: '/images/projects/omix-marketplace.webp',
    mark: 'OM',
    tags: ['Commerce', 'M-Pesa', 'Marketplace'],
  },
  {
    n: '04',
    name: 'OMIX Systems',
    type: 'Company · Software',
    title: 'The company behind the work.',
    body: 'Optimal Modular Integration Experts. A software company built around products, systems and integrations — SaaS platforms, business systems, websites and APIs.',
    href: 'https://omixsystems.store/',
    shot: '/images/projects/omix-systems.webp',
    mark: 'OS',
    tags: ['SaaS', 'APIs', 'Integrations'],
  },
];

// Other products in the OMIX ecosystem, shown as a compact grid.
const more = [
  {
    name: 'AIDE',
    type: 'Business management',
    body: 'A digital management platform helping small businesses replace paperwork with simple, reliable, offline-first workflows.',
    href: 'https://aide.omixsystems.store/',
  },
  {
    name: 'Bifrost',
    type: 'AI infrastructure',
    body: 'An AI model routing and orchestration layer connecting applications and agents to the right model through one programmable gateway.',
    href: 'https://bifrost.omixsystems.store/',
  },
  {
    name: 'Omni Analytics',
    type: 'Analytics',
    body: 'Analytics and project intelligence interface for tracking work, performance and progress.',
    href: 'https://omnianalytics.vercel.app/',
  },
];

// Experience — the company story, in numbered entries.
const xp = [
  {
    n: '01',
    role: 'Founder & CEO',
    org: 'OMIX Systems',
    orgHref: 'https://omixsystems.store/',
    range: 'Present · Kericho, Kenya',
    body:
      'Founded OMIX — Optimal Modular Integration Experts — to build digital products and integrated software systems that solve practical problems. The company combines product development with client engineering: SaaS platforms, business systems, websites and APIs designed to operate, scale and remain maintainable.',
    tags: ['Product engineering', 'Systems & integrations', 'Cloud & infrastructure', 'M-Pesa & payments'],
    link: 'Visit OMIX Systems ↗',
    linkHref: 'https://omixsystems.store/',
  },
  {
    n: '02',
    role: 'Building the OMIX ecosystem',
    org: 'Products & platform work',
    orgHref: 'https://blog.omixsystems.store/',
    range: 'Ongoing',
    body:
      'Not everything needs to be finished to be worth building. Veyra, Phikila, OMIX Marketplace, the OMIX Journal and new experiments — plus the infrastructure that supports them. I keep a portfolio because the work changes; this is a record of what is being built now, not a museum of finished projects.',
    tags: ['Veyra', 'Phikila', 'OMIX Marketplace', 'OMIX Journal'],
    link: 'Read the journal ↗',
    linkHref: 'https://blog.omixsystems.store/',
  },
];

const capabilities = [
  ['01', 'Product engineering', 'From rough idea to working product, with architecture designed to survive beyond an MVP.'],
  ['02', 'Systems & integrations', 'APIs, data, authentication, payments and services designed to connect rather than become islands.'],
  ['03', 'Cloud & infrastructure', 'Deployment, environments and operational foundations that keep products moving.'],
  ['04', 'AI & automation', 'Practical use of models, agents and automation where they create leverage instead of noise.'],
];

const favicon =
