    <script is:inline>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mobile = matchMedia('(max-width: 1080px)');

      /* Reveal-on-scroll */
      const reveal = new IntersectionObserver(e => e.forEach(x => { if (x.isIntersecting) x.target.classList.add('is-visible') }), { threshold: mobile.matches ? .08 : .14, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('[data-reveal]').forEach(e => reveal.observe(e));

      /* Scroll-spy — side nav + mobile menu */
      const sections = [...document.querySelectorAll('[data-section-target]')];
      const navLinks = [...document.querySelectorAll('[data-section]')];
      const setActive = id => navLinks.forEach(a => a.classList.toggle('is-active', a.dataset.section === id));
      const sectionObserver = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) setActive(entry.target.dataset.sectionTarget) }), { rootMargin: '-38% 0px -52% 0px', threshold: 0 });
      sections.forEach(s => sectionObserver.observe(s));

      /* Mobile menu */
      document.querySelectorAll('.mobile-menu a, .side-links a').forEach(a => a.addEventListener('click', () => {
        document.body.classList.remove('index-open');
        document.querySelector('.menu-btn')?.setAttribute('aria-expanded', 'false');
      }));
      const toggle = document.querySelector('.menu-btn');
      toggle?.addEventListener('click', () => {
        const open = !document.body.classList.contains('index-open');
        document.body.classList.toggle('index-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
      addEventListener('keydown', e => { if (e.key === 'Escape') { document.body.classList.remove('index-open'); toggle?.setAttribute('aria-expanded', 'false'); } });

      /* Parallax + scroll progress */
      const p = [...document.querySelectorAll('[data-parallax]')];
      let ticking = false;
      const update = () => {
        document.documentElement.style.setProperty('--scroll-y', `${scrollY}px`);
        if (reduce || mobile.matches) { ticking = false; return; }
        const vh = innerHeight;
        p.forEach(el => {
          const r = el.getBoundingClientRect(), v = Number(el.dataset.parallax || 0), o = ((r.top + r.height / 2 - vh / 2) / vh) * -70 * v;
          el.style.setProperty('--parallax-y', `${o}px`);
        });
        ticking = false;
      };
      addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
      addEventListener('resize', update, { passive: true });
      update();

      /* Magnetic buttons */
      document.querySelectorAll('.magnetic').forEach(el => {
        el.addEventListener('pointermove', e => {
          if (reduce || mobile.matches) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${(e.clientX - r.left - r.width / 2) * .12}px`);
          el.style.setProperty('--my', `${(e.clientY - r.top - r.height / 2) * .12}px`);
        });
        el.addEventListener('pointerleave', () => { el.style.setProperty('--mx', '0px'); el.style.setProperty('--my', '0px'); });
      });

      /* Formspree meeting-request flow */
      ;(() => {
        const form = document.getElementById('scheduleForm');
        const overlay = document.getElementById('scheduleOverlay');
        if (!form || !overlay) return;
        const title = document.getElementById('scheduleTitle');
        const stepLabel = document.getElementById('scheduleStepLabel');
        const progress = document.getElementById('scheduleBar');
        const panes = [...form.querySelectorAll('.schedule-pane')];
        const topicInput = document.getElementById('scheduleTopic');
        const nameInput = document.getElementById('scheduleName');
        const emailInput = document.getElementById('scheduleEmail');
        const dateInput = document.getElementById('scheduleDate');
        const timeInput = document.getElementById('scheduleTime');
        const summary = document.getElementById('scheduleSummary');
        const submitButton = document.getElementById('scheduleSubmit');
        const submitError = document.getElementById('scheduleSubmitError');
        const initialSubmitLabel = submitButton.textContent;
        const titles = {
          1: 'What would you like to talk about?',
          2: 'How can I reach you?',
          3: 'When would suit you?',
          4: 'Review your meeting request',
          5: 'Request received'
        };
        let step = 1;
        let opener = null;
        const localDate = () => {
          const now = new Date();
          const month = String(now.getMonth() + 1).padStart(2, '0');
          const day = String(now.getDate()).padStart(2, '0');
          return now.getFullYear() + '-' + month + '-' + day;
        };
        dateInput.min = localDate();

        function clearErrors() {
          form.querySelectorAll('.schedule-error').forEach(error => {
            error.hidden = true;
            error.textContent = '';
          });
          submitError.hidden = true;
          submitError.textContent = '';
        }
        function showError(paneNumber, message) {
          const error = panes[paneNumber - 1].querySelector('.schedule-error');
          if (!error) return;
          error.textContent = message;
          error.hidden = false;
        }
        function getValues() {
          return {
            topic: topicInput.value.trim(),
            name: nameInput.value.trim(),
            email: emailInput.value.trim(),
            company: document.getElementById('scheduleCompany').value.trim(),
            phone: document.getElementById('schedulePhone').value.trim(),
            date: dateInput.value,
            time: timeInput.value,
            timezone: document.getElementById('scheduleTimezone').value,
            format: document.getElementById('scheduleFormat').value,
            notes: document.getElementById('scheduleNotes').value.trim()
          };
        }
        function renderSummary() {
          const values = getValues();
          const rows = [
            ['Topic', values.topic], ['Name', values.name], ['Email', values.email],
            ['Company', values.company], ['Phone', values.phone], ['Preferred date', values.date],
            ['Preferred time', values.time], ['Time zone', values.timezone],
            ['Meeting format', values.format], ['Context', values.notes]
          ];
          summary.replaceChildren();
          rows.forEach(([label, value]) => {
            if (!value) return;
            const row = document.createElement('div');
            const key = document.createElement('span');
            const content = document.createElement('strong');
            key.textContent = label;
            content.textContent = value;
            row.append(key, content);
            summary.append(row);
          });
        }
        function show(nextStep) {
          step = nextStep;
          panes.forEach(pane => pane.classList.toggle('is-active', Number(pane.dataset.pane) === step));
          title.textContent = titles[step];
          stepLabel.textContent = step <= 4 ? 'Step ' + step + ' of 4' : 'Request sent';
          progress.style.width = (Math.min(step, 4) * 25) + '%';
          clearErrors();
          if (step === 4) renderSummary();
          const focusTarget = panes[step - 1].querySelector('input:not([type="hidden"]),select,textarea,button');
          if (focusTarget) focusTarget.focus({ preventScroll: true });
          form.scrollTo({ top: 0, behavior: 'auto' });
        }
        function resetForm() {
          form.reset();
          topicInput.value = '';
          form.querySelectorAll('.schedule-option').forEach(option => {
            option.classList.remove('is-selected');
            option.setAttribute('aria-checked', 'false');
          });
          submitButton.disabled = false;
          submitButton.textContent = initialSubmitLabel;
          dateInput.min = localDate();
          clearErrors();
        }
        function openModal(event) {
          opener = event.currentTarget;
          resetForm();
          overlay.classList.add('is-open');
          document.body.style.overflow = 'hidden';
          show(1);
        }
        function closeModal() {
          overlay.classList.remove('is-open');
          document.body.style.overflow = '';
          if (opener) opener.focus({ preventScroll: true });
        }
        document.querySelectorAll('[data-open-schedule]').forEach(button => button.addEventListener('click', openModal));
        overlay.querySelectorAll('[data-schedule-close]').forEach(button => button.addEventListener('click', closeModal));
        overlay.addEventListener('click', event => { if (event.target === overlay) closeModal(); });
        addEventListener('keydown', event => {
          if (event.key === 'Escape' && overlay.classList.contains('is-open')) closeModal();
          if (event.key === 'Tab' && overlay.classList.contains('is-open')) {
            const focusable = [...form.querySelectorAll('button:not([disabled]),input:not([type="hidden"]):not([disabled]),select:not([disabled]),textarea:not([disabled])')]
              .filter(element => element.getClientRects().length > 0);
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });
        form.querySelectorAll('.schedule-option').forEach(option => {
          option.addEventListener('click', () => {
            form.querySelectorAll('.schedule-option').forEach(item => {
              const selected = item === option;
              item.classList.toggle('is-selected', selected);
              item.setAttribute('aria-checked', String(selected));
            });
            topicInput.value = option.dataset.topic || '';
            clearErrors();
          });
        });
        form.querySelectorAll('[data-next]').forEach(button => {
          button.addEventListener('click', () => {
            clearErrors();
            if (step === 1 && !topicInput.value) {
              showError(1, 'Please select a topic so I can prepare for the conversation.');
              return;
            }
            if (step === 2) {
              if (!nameInput.value.trim() || !emailInput.value.trim() || !emailInput.checkValidity()) {
                showError(2, 'Enter your name and a valid email address. The other contact fields are optional.');
                if (!nameInput.value.trim()) nameInput.focus();
                else emailInput.focus();
                return;
              }
            }
            if (step === 3 && (!dateInput.value || dateInput.value < localDate() || !timeInput.value)) {
              showError(3, 'Choose today or a future date and a time window. You can select Flexible if you have no fixed preference.');
              return;
            }
            show(step + 1);
          });
        });
        form.querySelectorAll('[data-back]').forEach(button => button.addEventListener('click', () => show(Math.max(1, step - 1))));
        form.addEventListener('submit', async event => {
          event.preventDefault();
          if (step !== 4 || submitButton.disabled) return;
          const values = getValues();
          if (!values.topic) {
            show(1);
            showError(1, 'Please select a meeting topic.');
            return;
          }
          if (!values.name || !values.email || !emailInput.checkValidity()) {
            show(2);
            showError(2, 'Please enter your name and a valid email address.');
            return;
          }
          if (!values.date || values.date < localDate() || !values.time) {
            show(3);
            showError(3, 'Please choose a future date and a preferred time window.');
            return;
          }
          renderSummary();
          clearErrors();
          submitButton.disabled = true;
          submitButton.textContent = 'Sending…';
          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' }
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) {
              const detail = Array.isArray(result.errors) ? result.errors.map(item => item.message).filter(Boolean).join(' ') : '';
              show(4);
              showError(4, detail || 'The request could not be sent. Please try again.');
              return;
            }
            show(5);
          } catch (error) {
            show(4);
            showError(4, 'A connection problem prevented submission. Check your connection and try again.');
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = initialSubmitLabel;
          }
        });
      })();
    </script>
  </body>
</html>
