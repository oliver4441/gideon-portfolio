<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#04060c"/><title>Gideon Langat — Founder & CEO, OMIX Systems</title><meta name="description" content="Gideon Langat is the Founder & CEO of OMIX Systems, a software developer and product builder."/><link rel="canonical" href="https://admin.omixsystems.store/"/><link rel="preload" as="image" href="/images/site-background.jpg" fetchpriority="high"/><link rel="icon" type="image/webp" href={img('gideon-logo.webp')}/><link rel="apple-touch-icon" href={img('gideon-logo.webp')}/><meta property="og:type" content="website"/><meta property="og:url" content="https://admin.omixsystems.store/"/><meta property="og:title" content="Gideon Langat — Founder & CEO, OMIX Systems"/><meta property="og:description" content="Software developer, product builder and founder of OMIX Systems."/><meta property="og:image" content="https://admin.omixsystems.store/images/gideon-profile.webp"/><ClientRouter/><style is:global>
.section-rail{position:fixed;z-index:45;right:22px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:flex-end;gap:4px;padding:10px 0;mix-blend-mode:normal}.rail-label{font:600 9px/1 'DM Sans',system-ui,sans-serif;letter-spacing:.18em;color:rgba(255,255,255,.75);margin:0 9px 9px 0}.rail-link{position:relative;display:grid;grid-template-columns:28px auto;align-items:center;gap:8px;min-width:86px;padding:7px 9px;border-radius:2px;color:rgba(255,255,255,.72);font-size:10px;letter-spacing:.08em;text-transform:uppercase;transition:color .25s ease,background .25s ease,transform .25s ease}.rail-link span{font-size:9px;opacity:.65;text-align:right}.rail-link strong{font-weight:500}.rail-link:before{content:'';position:absolute;right:0;top:0;bottom:0;width:2px;background:var(--ink);transform:scaleY(0);transform-origin:center;transition:transform .25s ease}.rail-link:hover,.rail-link.is-active{color:var(--ink);background:rgba(2,4,11,.86);transform:translateX(-3px)}.rail-link.is-active:before{transform:scaleY(1)}.rail-progress{position:absolute;right:0;top:38px;bottom:10px;width:1px;background:rgba(255,255,255,.24);pointer-events:none}.rail-progress i{position:absolute;inset:0 0 auto;width:1px;height:100%;background:var(--ink);transform:scaleY(0);transform-origin:top;transition:transform .45s cubic-bezier(.2,.8,.2,1)}.nav-links a.is-active{position:relative;color:var(--ink)}.nav-links a.is-active:after{content:'';position:absolute;left:0;right:0;bottom:-8px;height:1px;background:var(--ink)}
@media(max-width:1100px){.section-rail{right:10px}.rail-link{min-width:76px}}
@media(max-width:900px){.section-rail{display:none}.mobile-index-toggle{position:fixed;z-index:60;right:14px;bottom:16px;display:flex;align-items:center;gap:9px;padding:11px 13px;border:1px solid rgba(255,255,255,.24);background:rgba(2,4,11,.94);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);color:var(--ink);font:600 11px/1 'DM Sans',system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;box-shadow:0 8px 25px rgba(0,0,0,.08)}.mobile-index-toggle span{font-size:14px}.mobile-index{position:fixed;z-index:59;inset:0;display:flex;flex-direction:column;padding:24px 20px;background:rgba(2,4,11,.96);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);opacity:0;visibility:hidden;transform:translateY(16px);transition:opacity .25s ease,transform .25s ease,visibility .25s}.index-open .mobile-index{opacity:1;visibility:visible;transform:none}.mobile-index-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid var(--line);font:600 11px/1 'DM Sans',system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase}.mobile-index-head button{border:0;background:transparent;color:var(--ink);font-size:30px;line-height:1;padding:0}.mobile-index-links{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:12px}.mobile-index-links a{display:grid;grid-template-columns:38px 1fr;align-items:center;padding:17px 4px;border-bottom:1px solid var(--line);font:500 clamp(1.25rem,5vw,1.8rem)/1 'Playfair Display',Georgia,serif;color:var(--ink);transition:padding .2s ease}.mobile-index-links a span{font:500 10px/1 'DM Sans',system-ui,sans-serif;color:var(--muted)}.mobile-index-links a.is-active{padding-left:10px}.mobile-index-links a.is-active span{color:var(--accent)}.index-open{overflow:hidden}.nav-company{padding-right:54px}}
@media(max-width:560px){.mobile-index-links{grid-template-columns:1fr}.mobile-index-links a{padding-block:14px}.mobile-index-toggle{bottom:13px;right:12px}}
@media(prefers-reduced-motion:reduce){.rail-link,.mobile-index,.mobile-index-links a{transition:none}}

.button.gold{background:#d69a4b;border-color:#d69a4b;color:#0b0d14}
.button.gold:hover{background:#e2a75c;border-color:#e2a75c}
button.button{font-family:'DM Sans',system-ui,sans-serif;cursor:pointer}
.schedule-overlay{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(1,2,7,.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);opacity:0;visibility:hidden;transition:opacity .3s ease,visibility .3s}
.schedule-overlay.is-open{opacity:1;visibility:visible}
.schedule-modal{position:relative;width:min(560px,100%);max-height:calc(100svh - 40px);overflow:auto;background:#0b0d14;border:1px solid rgba(255,255,255,.22);padding:34px 34px 30px;box-shadow:0 30px 80px rgba(0,0,0,.5);transform:translateY(14px);transition:transform .3s ease}
.schedule-overlay.is-open .schedule-modal{transform:none}
.schedule-close{position:absolute;top:10px;right:14px;border:0;background:transparent;color:#fff;font-size:30px;line-height:1;cursor:pointer;opacity:.7}
.schedule-close:hover{opacity:1}
.schedule-progress{height:2px;background:rgba(255,255,255,.16);margin-bottom:16px}
.schedule-progress i{display:block;height:100%;width:33.33%;background:#d69a4b;transition:width .3s ease}
.schedule-step{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.6);margin:0 0 8px}
.schedule-modal h3{font-size:clamp(1.6rem,4vw,2.1rem);margin:0 0 22px;color:#fff}
.schedule-pane{display:none}
.schedule-pane.is-active{display:block}
.schedule-options{display:grid;gap:10px}
.schedule-option{display:grid;grid-template-columns:22px 1fr;gap:12px;align-items:start;text-align:left;padding:14px 16px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.18);color:#fff;cursor:pointer;transition:border-color .2s,background .2s;font-family:'DM Sans',system-ui,sans-serif}
.schedule-option:hover{border-color:rgba(255,255,255,.45)}
.schedule-option.is-selected{border-color:#d69a4b;background:rgba(214,154,75,.10)}
.schedule-option .dot{width:14px;height:14px;margin-top:4px;border:1px solid rgba(255,255,255,.5);border-radius:50%;position:relative}
.schedule-option.is-selected .dot{border-color:#d69a4b}
.schedule-option.is-selected .dot:after{content:'';position:absolute;inset:3px;border-radius:50%;background:#d69a4b}
.schedule-option strong{display:block;font-size:15px;font-weight:600}
.schedule-option span{font-size:13px;color:rgba(255,255,255,.65)}
.schedule-field{display:block;margin-bottom:14px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.65)}
.schedule-field input,.schedule-field textarea{display:block;width:100%;margin-top:8px;padding:13px 14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.2);color:#fff;font:400 16px/1.4 'DM Sans',system-ui,sans-serif;letter-spacing:0;text-transform:none}
.schedule-field textarea{min-height:110px;resize:vertical}
.schedule-field input:focus,.schedule-field textarea:focus{outline:none;border-color:#d69a4b}
.schedule-field input::placeholder,.schedule-field textarea::placeholder{color:rgba(255,255,255,.35)}
.schedule-error{color:#f0a35e;font-size:13px;margin:12px 0 0}
.schedule-summary{margin:18px 0 4px;padding:6px 16px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.03);font-size:14px;color:rgba(255,255,255,.85)}
.schedule-summary div{display:flex;justify-content:space-between;gap:16px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.08)}
.schedule-summary div:last-child{border-bottom:0}
.schedule-summary span{color:rgba(255,255,255,.55)}
.schedule-summary strong{font-weight:600;text-align:right;overflow:hidden;text-overflow:ellipsis}
.schedule-note{font-size:13px;color:rgba(255,255,255,.6);margin:14px 0 0}
.schedule-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:24px}
.schedule-nav .button{min-width:170px}
.schedule-done-text{font-size:15px;color:rgba(255,255,255,.85);margin:0 0 8px}
@media(max-width:560px){.schedule-modal{padding:26px 20px 22px}.schedule-nav .button{min-width:0;flex:1}}
@media(prefers-reduced-motion:reduce){.schedule-overlay,.schedule-modal,.schedule-progress i{transition:none}}
</style></head>
