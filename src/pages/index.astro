---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const img=(name)=>`/images/${name}`;
const work=[{n:'01',name:'Veyra',type:'Product · Media',title:'A cinematic streaming platform.',body:'A product exploring discovery, presentation and the infrastructure required to turn a media idea into a usable platform.',href:'https://web-jade-one-82.vercel.app/?type=series'},{n:'02',name:'Phikila',type:'Product · Education',title:'School management, treated as a system.',body:'A connected platform for school operations, academic workflows and the information institutions rely on every day.',href:'https://phikila.com/'},{n:'03',name:'OMIX Marketplace',type:'Product · Commerce · OMIX',title:'A local marketplace built for Kericho.',body:'OMIX’s flagship commerce platform, connecting local buyers and sellers with an online marketplace designed around the Kenyan market, including M-Pesa-enabled commerce.',href:'https://market.omixsystems.store/'},{n:'04',name:'OMIX Systems',type:'Company · Software',title:'The company behind the work.',body:'Optimal Modular Integration Experts. A software company built around products, systems and integrations.',href:'https://omixsystems.store/'}];
const capabilities=[['01','Product engineering','From rough idea to working product, with architecture designed to survive beyond an MVP.'],['02','Systems & integrations','APIs, data, authentication, payments and services designed to connect rather than become islands.'],['03','Cloud & infrastructure','Deployment, environments and operational foundations that keep products moving.'],['04','AI & automation','Practical use of models, agents and automation where they create leverage instead of noise.']];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#f3f0e9"/><title>Gideon Langat — Founder & CEO, OMIX Systems</title><meta name="description" content="Gideon Langat is the Founder & CEO of OMIX Systems, a software developer and product builder."/><link rel="canonical" href="https://admin.omixsystems.store/"/><link rel="icon" type="image/webp" href={img('gideon-logo.webp')}/><link rel="apple-touch-icon" href={img('gideon-logo.webp')}/><meta property="og:type" content="website"/><meta property="og:url" content="https://admin.omixsystems.store/"/><meta property="og:title" content="Gideon Langat — Founder & CEO, OMIX Systems"/><meta property="og:description" content="Software developer, product builder and founder of OMIX Systems."/><meta property="og:image" content="https://admin.omixsystems.store/images/gideon-profile.webp"/><ClientRouter/><style is:global>
.section-rail{position:fixed;z-index:45;right:22px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:flex-end;gap:4px;padding:10px 0;mix-blend-mode:normal}.rail-label{font:600 9px/1 'DM Sans',system-ui,sans-serif;letter-spacing:.18em;color:rgba(23,23,19,.55);margin:0 9px 9px 0}.rail-link{position:relative;display:grid;grid-template-columns:28px auto;align-items:center;gap:8px;min-width:86px;padding:7px 9px;border-radius:2px;color:rgba(23,23,19,.52);font-size:10px;letter-spacing:.08em;text-transform:uppercase;transition:color .25s ease,background .25s ease,transform .25s ease}.rail-link span{font-size:9px;opacity:.65;text-align:right}.rail-link strong{font-weight:500}.rail-link:before{content:'';position:absolute;right:0;top:0;bottom:0;width:2px;background:var(--ink);transform:scaleY(0);transform-origin:center;transition:transform .25s ease}.rail-link:hover,.rail-link.is-active{color:var(--ink);background:rgba(243,240,233,.7);transform:translateX(-3px)}.rail-link.is-active:before{transform:scaleY(1)}.rail-progress{position:absolute;right:0;top:38px;bottom:10px;width:1px;background:rgba(23,23,19,.14);pointer-events:none}.rail-progress i{position:absolute;inset:0 0 auto;width:1px;height:100%;background:var(--ink);transform:scaleY(0);transform-origin:top;transition:transform .45s cubic-bezier(.2,.8,.2,1)}.nav-links a.is-active{position:relative;color:var(--ink)}.nav-links a.is-active:after{content:'';position:absolute;left:0;right:0;bottom:-8px;height:1px;background:var(--ink)}
@media(max-width:1100px){.section-rail{right:10px}.rail-link{min-width:76px}}
@media(max-width:900px){.section-rail{display:none}.mobile-index-toggle{position:fixed;z-index:60;right:14px;bottom:16px;display:flex;align-items:center;gap:9px;padding:11px 13px;border:1px solid rgba(23,23,19,.18);background:rgba(243,240,233,.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);color:var(--ink);font:600 11px/1 'DM Sans',system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;box-shadow:0 8px 25px rgba(0,0,0,.08)}.mobile-index-toggle span{font-size:14px}.mobile-index{position:fixed;z-index:59;inset:0;display:flex;flex-direction:column;padding:24px 20px;background:rgba(243,240,233,.96);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);opacity:0;visibility:hidden;transform:translateY(16px);transition:opacity .25s ease,transform .25s ease,visibility .25s}.index-open .mobile-index{opacity:1;visibility:visible;transform:none}.mobile-index-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid var(--line);font:600 11px/1 'DM Sans',system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase}.mobile-index-head button{border:0;background:transparent;color:var(--ink);font-size:30px;line-height:1;padding:0}.mobile-index-links{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:12px}.mobile-index-links a{display:grid;grid-template-columns:38px 1fr;align-items:center;padding:17px 4px;border-bottom:1px solid var(--line);font:500 clamp(1.25rem,5vw,1.8rem)/1 'Playfair Display',Georgia,serif;color:var(--ink);transition:padding .2s ease}.mobile-index-links a span{font:500 10px/1 'DM Sans',system-ui,sans-serif;color:var(--muted)}.mobile-index-links a.is-active{padding-left:10px}.mobile-index-links a.is-active span{color:var(--accent)}.index-open{overflow:hidden}.nav-company{padding-right:54px}}
@media(max-width:560px){.mobile-index-links{grid-template-columns:1fr}.mobile-index-links a{padding-block:14px}.mobile-index-toggle{bottom:13px;right:12px}}
@media(prefers-reduced-motion:reduce){.rail-link,.mobile-index,.mobile-index-links a{transition:none}}
</style></head>
<body><div class="space-scene" aria-hidden="true"><canvas id="gpu-space"></canvas><div class="stars stars-a"></div><div class="stars stars-b"></div><div class="stars stars-c"></div><div class="nebula"></div></div><div class="progress" aria-hidden="true"></div>
<nav class="site-nav"><a href="#top" class="wordmark magnetic"><img src={img('gideon-logo.webp')} alt="Gideon Langat"/><span>GIDEON<span>.</span></span></a><div class="nav-links"><a href="#work" data-top-link="work">Work</a><a href="#notes" data-top-link="notes">Notes</a><a href="#about" data-top-link="about">About</a><a href="#contact" data-top-link="contact">Contact</a></div><a class="nav-company magnetic" href="https://omixsystems.store/">OMIX Systems ↗</a></nav>
<nav class="section-rail" aria-label="Page sections"><div class="rail-label">INDEX</div><a class="rail-link is-active" href="#top" data-section="top"><span>00</span><strong>Home</strong></a><a class="rail-link" href="#about" data-section="about"><span>01</span><strong>About</strong></a><a class="rail-link" href="#work" data-section="work"><span>02</span><strong>Work</strong></a><a class="rail-link" href="#current" data-section="current"><span>03</span><strong>Now</strong></a><a class="rail-link" href="#build" data-section="build"><span>04</span><strong>Build</strong></a><a class="rail-link" href="#notes" data-section="notes"><span>05</span><strong>Notes</strong></a><a class="rail-link" href="#life" data-section="life"><span>06</span><strong>Life</strong></a><a class="rail-link" href="#omix" data-section="omix"><span>07</span><strong>OMIX</strong></a><a class="rail-link" href="#contact" data-section="contact"><span>08</span><strong>Contact</strong></a><div class="rail-progress"><i></i></div></nav>
<button class="mobile-index-toggle" type="button" aria-expanded="false" aria-controls="mobile-index">Index <span>☰</span></button><nav id="mobile-index" class="mobile-index" aria-label="Mobile page sections"><div class="mobile-index-head"><span>Navigate</span><button type="button" data-close-index aria-label="Close navigation">×</button></div><div class="mobile-index-links"><a href="#top" data-section="top"><span>00</span>Home</a><a href="#about" data-section="about"><span>01</span>About</a><a href="#work" data-section="work"><span>02</span>Work</a><a href="#current" data-section="current"><span>03</span>Now</a><a href="#build" data-section="build"><span>04</span>Build</a><a href="#notes" data-section="notes"><span>05</span>Notes</a><a href="#life" data-section="life"><span>06</span>Life</a><a href="#omix" data-section="omix"><span>07</span>OMIX</a><a href="#contact" data-section="contact"><span>08</span>Contact</a></div></nav>
<main id="top"><section class="hero editorial-wrap snap-section" data-reveal data-section-target="top"><div class="hero-copy"><p class="eyebrow">Founder & CEO · OMIX Systems · Kenya</p><h1>I build products,<br/><em>systems</em> and companies.</h1><p class="hero-lede">In that order.</p><p class="hero-intro">I'm Gideon Langat, a software developer and product builder. I lead OMIX Systems, where I turn ideas into digital products and the systems behind them.</p><div class="hero-actions"><a class="button dark magnetic" href="#work">See the work</a><a class="text-link" href="https://omixsystems.store/">Explore OMIX →</a></div></div><figure class="hero-photo depth" data-parallax="0.12"><picture><source media="(max-width: 900px)" srcset={img('gideon-logo.webp')}/><img src={img('gideon-profile.webp')} alt="Gideon Langat" fetchpriority="high"/></picture><figcaption>GIDEON LANGAT · 2026</figcaption></figure></section>
<section id="about" class="editorial-wrap section-block snap-section" data-reveal data-section-target="about"><div class="section-label">01 / Hello</div><div class="two-column"><h2>I like building things that connect.</h2><div class="prose"><p>Software is rarely useful in isolation. The product, the data, the people using it and the services underneath all have to make sense together.</p><p>That is the thinking behind my work. I move between engineering, product decisions and the business questions around them — building systems that are practical first and ambitious second.</p><p>OMIX Systems is the company I am building around that philosophy.</p></div></div></section>
<section id="work" class="editorial-wrap section-block snap-section" data-reveal data-section-target="work"><div class="section-label">02 / Selected product work</div><div class="work-list">{work.map(item=><article class="work-item depth" data-parallax="0.06"><div class="work-index">{item.n}</div><div class="work-content"><p class="eyebrow">{item.type}</p><h3>{item.name}</h3><h4>{item.title}</h4><p>{item.body}</p><a class="magnetic" href={item.href}>View project <span>↗</span></a></div></article>)}</div></section>
<section id="current" class="editorial-wrap section-block snap-section" data-reveal data-section-target="current"><div class="section-label">03 / Currently building</div><div class="current-grid"><h2>Not everything needs to be finished to be worth building.</h2><div class="current-copy"><p>Veyra. Phikila. OMIX Marketplace. OMIX Journal. New experiments. Infrastructure that supports them.</p><p>I keep a portfolio because the work changes. This is a record of what is being built now, not a museum of finished projects.</p><a class="text-link" href="https://blog.omixsystems.store/">Read the journal →</a></div></div></section>
<section id="build" class="editorial-wrap section-block snap-section" data-reveal data-section-target="build"><div class="section-label">04 / How I build</div><div class="capability-list">{capabilities.map(([n,title,text])=><div class="capability"><span>{n}</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
<section id="notes" class="editorial-wrap section-block snap-section" data-reveal data-section-target="notes"><div class="section-label">05 / Notes from building OMIX</div><div class="two-column notes-head"><h2>Things I'm thinking about.</h2><p class="prose">Writing is where I slow down enough to explain the decisions behind the products.</p></div><div class="notes-list"><a href="https://blog.omixsystems.store/" class="note-row"><span>Engineering</span><strong>Why modular systems matter</strong><span>↗</span></a><a href="https://blog.omixsystems.store/" class="note-row"><span>Founder notes</span><strong>Building products through OMIX</strong><span>↗</span></a><a href="https://blog.omixsystems.store/" class="note-row"><span>Product</span><strong>What makes software useful?</strong><span>↗</span></a></div></section>
<section id="life" class="editorial-wrap section-block snap-section" data-reveal data-section-target="life"><div class="section-label">06 / Outside the code</div><div class="life-grid"><div class="life-copy"><h2>There's more to building than sitting at a screen.</h2><p>These are the parts of life that do not fit neatly into a CV — time outside, games, experiments, and the people and places that keep the work in perspective.</p></div><div class="life-images"><figure class="depth" data-parallax="0.10"><img src={img('gideon-outdoors.webp')} alt="Gideon outdoors" loading="lazy"/></figure><figure class="depth" data-parallax="0.16"><img src={img('gideon-gaming.webp')} alt="Gideon gaming" loading="lazy"/></figure><figure class="depth wide" data-parallax="0.08"><img src={img('gideon-workspace.webp')} alt="Gideon workspace" loading="lazy"/></figure></div></div></section>
<section id="omix" class="omix-panel snap-section" data-reveal data-section-target="omix"><div class="editorial-wrap"><p class="eyebrow">07 / The company behind the work</p><h2>OMIX Systems</h2><p>Optimal Modular Integration Experts.</p><p class="omix-description">I founded OMIX to build digital products and integrated software systems that solve practical problems.</p><a class="button light magnetic" href="https://omixsystems.store/">Visit OMIX Systems ↗</a></div></section><section id="contact" class="editorial-wrap contact-section section-block snap-section" data-reveal data-section-target="contact"><div class="section-label">08 / Let's build something</div><h2>Have an idea worth making?</h2><p>Tell me what you are trying to build. If it makes sense, we can work out the system behind it.</p><div class="contact-actions"><a class="button dark magnetic" href="https://omixsystems.store/">Build with OMIX</a><a class="button outline magnetic" href="mailto:hello@omixsystems.store">Email Gideon</a></div></section></main>
<footer class="site-footer editorial-wrap"><div><strong>GIDEON LANGAT</strong><span>Founder & CEO · OMIX Systems</span></div><div><a href="https://omixsystems.store/">OMIX Systems</a><a href="https://blog.omixsystems.store/">Journal</a><a href="https://github.com/oliver4441">GitHub</a></div><small>© 2026 Gideon Langat. Built through OMIX Systems.</small></footer>
<script is:inline>import('/src/scripts/gpu-space.js');const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const mobile=matchMedia('(max-width: 900px)');const reveal=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('is-visible')}),{threshold:mobile.matches?.08:.14,rootMargin:'0px 0px -8% 0px'});document.querySelectorAll('[data-reveal]').forEach(e=>reveal.observe(e));const sections=[...document.querySelectorAll('[data-section-target]')],railLinks=[...document.querySelectorAll('.rail-link')],mobileLinks=[...document.querySelectorAll('.mobile-index-links a')],topLinks=[...document.querySelectorAll('[data-top-link]')];const setActive=id=>{railLinks.forEach(a=>a.classList.toggle('is-active',a.dataset.section===id));mobileLinks.forEach(a=>a.classList.toggle('is-active',a.dataset.section===id));topLinks.forEach(a=>a.classList.toggle('is-active',a.dataset.topLink===id));const progress=document.querySelector('.rail-progress i');if(progress){progress.style.transform=`scaleY(${Math.max(0,(sections.findIndex(s=>s.dataset.sectionTarget===id)+1)/sections.length)})`}};const sectionObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)setActive(entry.target.dataset.sectionTarget)}),{rootMargin:'-38% 0px -52% 0px',threshold:0});sections.forEach(s=>sectionObserver.observe(s));document.querySelectorAll('.rail-link,.mobile-index-links a,.nav-links a').forEach(a=>a.addEventListener('click',()=>{document.body.classList.remove('index-open');document.querySelector('.mobile-index-toggle')?.setAttribute('aria-expanded','false')}));const toggle=document.querySelector('.mobile-index-toggle'),close=document.querySelector('[data-close-index]');toggle?.addEventListener('click',()=>{const open=!document.body.classList.contains('index-open');document.body.classList.toggle('index-open',open);toggle.setAttribute('aria-expanded',String(open))});close?.addEventListener('click',()=>{document.body.classList.remove('index-open');toggle?.setAttribute('aria-expanded','false')});const p=[...document.querySelectorAll('[data-parallax]')];let ticking=false;const update=()=>{if(reduce||mobile.matches){document.documentElement.style.setProperty('--scroll-y',`${scrollY}px`);return}const vh=innerHeight;p.forEach(el=>{const r=el.getBoundingClientRect(),v=Number(el.dataset.parallax||0),o=((r.top+r.height/2-vh/2)/vh)*-70*v;el.style.setProperty('--parallax-y',`${o}px`);el.style.setProperty('--parallax-r',`${o*.025}deg`)});document.documentElement.style.setProperty('--scroll-y',`${scrollY}px`);ticking=false};addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(update);ticking=true}},{passive:true});addEventListener('resize',update,{passive:true});update();document.querySelectorAll('.magnetic').forEach(el=>{el.addEventListener('pointermove',e=>{if(reduce||mobile.matches)return;const r=el.getBoundingClientRect();el.style.setProperty('--mx',`${(e.clientX-r.left-r.width/2)*.12}px`);el.style.setProperty('--my',`${(e.clientY-r.top-r.height/2)*.12}px`)});el.addEventListener('pointerleave',()=>{el.style.setProperty('--mx','0px');el.style.setProperty('--my','0px')})});</script></body></html>
