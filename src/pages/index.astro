---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const img=(name)=>`/images/${name}`;
const work=[{n:'01',name:'Veyra',type:'Product · Media',title:'A cinematic streaming platform.',body:'A product exploring discovery, presentation and the infrastructure required to turn a media idea into a usable platform.',href:'https://web-jade-one-82.vercel.app/?type=series'},{n:'02',name:'Phikila',type:'Product · Education',title:'School management, treated as a system.',body:'A connected platform for school operations, academic workflows and the information institutions rely on every day.',href:'https://phikila.com/'},{n:'03',name:'OMIX Marketplace',type:'Product · Commerce · OMIX',title:'A local marketplace built for Kericho.',body:'OMIX’s flagship commerce platform, connecting local buyers and sellers with an online marketplace designed around the Kenyan market, including M-Pesa-enabled commerce.',href:'https://market.omixsystems.store/'},{n:'04',name:'OMIX Systems',type:'Company · Software',title:'The company behind the work.',body:'Optimal Modular Integration Experts. A software company built around products, systems and integrations.',href:'https://omixsystems.store/'}];
const capabilities=[['01','Product engineering','From rough idea to working product, with architecture designed to survive beyond an MVP.'],['02','Systems & integrations','APIs, data, authentication, payments and services designed to connect rather than become islands.'],['03','Cloud & infrastructure','Deployment, environments and operational foundations that keep products moving.'],['04','AI & automation','Practical use of models, agents and automation where they create leverage instead of noise.']];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#f3f0e9"/><title>Gideon Langat — Founder & CEO, OMIX Systems</title><meta name="description" content="Gideon Langat is the Founder & CEO of OMIX Systems, a software developer and product builder."/><link rel="canonical" href="https://admin.omixsystems.store/"/><link rel="icon" type="image/webp" href={img('gideon-logo.webp')}/><link rel="apple-touch-icon" href={img('gideon-logo.webp')}/><meta property="og:type" content="website"/><meta property="og:url" content="https://admin.omixsystems.store/"/><meta property="og:title" content="Gideon Langat — Founder & CEO, OMIX Systems"/><meta property="og:description" content="Software developer, product builder and founder of OMIX Systems."/><meta property="og:image" content="https://admin.omixsystems.store/images/gideon-profile.webp"/><ClientRouter/></head>
<body><div class="space-scene" aria-hidden="true"><canvas id="gpu-space"></canvas><div class="stars stars-a"></div><div class="stars stars-b"></div><div class="stars stars-c"></div><div class="nebula"></div></div><div class="progress" aria-hidden="true"></div>
<nav class="site-nav"><a href="/#top" class="wordmark magnetic"><img src={img('gideon-logo.webp')} alt="Gideon Langat"/><span>GIDEON<span>.</span></span></a><div class="nav-links"><a href="/#work">Work</a><a href="/#notes">Notes</a><a href="/#about">About</a><a href="/#contact">Contact</a></div><a class="nav-company magnetic" href="https://omixsystems.store/">OMIX Systems ↗</a></nav>
<main id="top"><section class="hero editorial-wrap snap-section" data-reveal><div class="hero-copy"><p class="eyebrow">Founder & CEO · OMIX Systems · Kenya</p><h1>I build products,<br/><em>systems</em> and companies.</h1><p class="hero-lede">In that order.</p><p class="hero-intro">I'm Gideon Langat, a software developer and product builder. I lead OMIX Systems, where I turn ideas into digital products and the systems behind them.</p><div class="hero-actions"><a class="button dark magnetic" href="#work">See the work</a><a class="text-link" href="https://omixsystems.store/">Explore OMIX →</a></div></div><figure class="hero-photo depth" data-parallax="0.12"><picture><source media="(max-width: 900px)" srcset={img('gideon-logo.webp')}/><img src={img('gideon-profile.webp')} alt="Gideon Langat" fetchpriority="high"/></picture><figcaption>GIDEON LANGAT · 2026</figcaption></figure></section>
<section id="about" class="editorial-wrap section-block snap-section" data-reveal><div class="section-label">01 / Hello</div><div class="two-column"><h2>I like building things that connect.</h2><div class="prose"><p>Software is rarely useful in isolation. The product, the data, the people using it and the services underneath all have to make sense together.</p><p>That is the thinking behind my work. I move between engineering, product decisions and the business questions around them — building systems that are practical first and ambitious second.</p><p>OMIX Systems is the company I am building around that philosophy.</p></div></div></section>
<section id="work" class="editorial-wrap section-block snap-section" data-reveal><div class="section-label">02 / Selected product work</div><div class="work-list">{work.map(item=><article class="work-item depth" data-parallax="0.06"><div class="work-index">{item.n}</div><div class="work-content"><p class="eyebrow">{item.type}</p><h3>{item.name}</h3><h4>{item.title}</h4><p>{item.body}</p><a class="magnetic" href={item.href}>View project <span>↗</span></a></div></article>)}</div></section>
<section class="editorial-wrap section-block snap-section" data-reveal><div class="section-label">03 / Currently building</div><div class="current-grid"><h2>Not everything needs to be finished to be worth building.</h2><div class="current-copy"><p>Veyra. Phikila. OMIX Marketplace. OMIX Journal. New experiments. Infrastructure that supports them.</p><p>I keep a portfolio because the work changes. This is a record of what is being built now, not a museum of finished projects.</p><a class="text-link" href="https://blog.omixsystems.store/">Read the journal →</a></div></div></section>
<section class="editorial-wrap section-block snap-section" data-reveal><div class="section-label">04 / How I build</div><div class="capability-list">{capabilities.map(([n,title,text])=><div class="capability"><span>{n}</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
<section id="notes" class="editorial-wrap section-block snap-section" data-reveal><div class="section-label">05 / Notes from building OMIX</div><div class="two-column notes-head"><h2>Things I'm thinking about.</h2><p class="prose">Writing is where I slow down enough to explain the decisions behind the products.</p></div><div class="notes-list"><a href="https://blog.omixsystems.store/" class="note-row"><span>Engineering</span><strong>Why modular systems matter</strong><span>↗</span></a><a href="https://blog.omixsystems.store/" class="note-row"><span>Founder notes</span><strong>Building products through OMIX</strong><span>↗</span></a><a href="https://blog.omixsystems.store/" class="note-row"><span>Product</span><strong>What makes software useful?</strong><span>↗</span></a></div></section>
<section class="editorial-wrap section-block snap-section" data-reveal><div class="section-label">06 / Outside the code</div><div class="life-grid"><div class="life-copy"><h2>There's more to building than sitting at a screen.</h2><p>These are the parts of life that do not fit neatly into a CV — time outside, games, experiments, and the people and places that keep the work in perspective.</p></div><div class="life-images"><figure class="depth" data-parallax="0.10"><img src={img('gideon-outdoors.webp')} alt="Gideon outdoors" loading="lazy"/></figure><figure class="depth" data-parallax="0.16"><img src={img('gideon-gaming.webp')} alt="Gideon gaming" loading="lazy"/></figure><figure class="depth wide" data-parallax="0.08"><img src={img('gideon-workspace.webp')} alt="Gideon workspace" loading="lazy"/></figure></div></div></section>
<section class="omix-panel snap-section" data-reveal><div class="editorial-wrap"><p class="eyebrow">07 / The company behind the work</p><h2>OMIX Systems</h2><p>Optimal Modular Integration Experts.</p><p class="omix-description">I founded OMIX to build digital products and integrated software systems that solve practical problems.</p><a class="button light magnetic" href="https://omixsystems.store/">Visit OMIX Systems ↗</a></div></section><section id="contact" class="editorial-wrap contact-section section-block snap-section" data-reveal><div class="section-label">08 / Let's build something</div><h2>Have an idea worth making?</h2><p>Tell me what you are trying to build. If it makes sense, we can work out the system behind it.</p><div class="contact-actions"><a class="button dark magnetic" href="https://omixsystems.store/">Build with OMIX</a><a class="button outline magnetic" href="mailto:hello@omixsystems.store">Email Gideon</a></div></section></main>
<footer class="site-footer editorial-wrap"><div><strong>GIDEON LANGAT</strong><span>Founder & CEO · OMIX Systems</span></div><div><a href="https://omixsystems.store/">OMIX Systems</a><a href="https://blog.omixsystems.store/">Journal</a><a href="https://github.com/oliver4441">GitHub</a></div><small>© 2026 Gideon Langat. Built through OMIX Systems.</small></footer>
<script is:inline>import('/src/scripts/gpu-space.js');const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const mobile=matchMedia('(max-width: 900px)');const ro=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('is-visible')}),{threshold:mobile.matches?.08:.14,rootMargin:'0px 0px -8% 0px'});document.querySelectorAll('[data-reveal]').forEach(e=>ro.observe(e));const p=[...document.querySelectorAll('[data-parallax]')];let ticking=false;const update=()=>{if(reduce||mobile.matches){document.documentElement.style.setProperty('--scroll-y',`${scrollY}px`);return}const vh=innerHeight;p.forEach(el=>{const r=el.getBoundingClientRect(),v=Number(el.dataset.parallax||0),o=((r.top+r.height/2-vh/2)/vh)*-70*v;el.style.setProperty('--parallax-y',`${o}px`);el.style.setProperty('--parallax-r',`${o*.025}deg`)});document.documentElement.style.setProperty('--scroll-y',`${scrollY}px`);ticking=false};addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(update);ticking=true}},{passive:true});addEventListener('resize',update,{passive:true});update();document.querySelectorAll('.magnetic').forEach(el=>{el.addEventListener('pointermove',e=>{if(reduce||mobile.matches)return;const r=el.getBoundingClientRect();el.style.setProperty('--mx',`${(e.clientX-r.left-r.width/2)*.12}px`);el.style.setProperty('--my',`${(e.clientY-r.top-r.height/2)*.12}px`)});el.addEventListener('pointerleave',()=>{el.style.setProperty('--mx','0px');el.style.setProperty('--my','0px')})});</script></body></html>
